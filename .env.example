# --- Required: AI ---
# From the Anthropic console. Leave unset and NL translation fails closed.
ANTHROPIC_API_KEY=

# --- Required: internal control-plane DB (audit log + agents + databases + encrypted creds) ---
# Railway provisions this — set DATABASE_URL automatically.
DATABASE_URL=postgresql://user:pass@host:5432/queryshield

# --- Required: vault encryption key (Fernet) ---
# Generate once with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts database connection strings AND named credentials (the vault feature).
# There is one key. Losing it makes every stored secret unreadable.
# Connection-string and named-credential routes fail closed when this is unset.
# Session cookies use SESSION_KEY, or VAULT_KEY when SESSION_KEY is unset.
# There is no built-in fallback. Do not commit a key.
VAULT_KEY=

# --- Optional: cache ---
# If unset, cache falls back to in-memory dict (fine for single-instance deploys).
REDIS_URL=

# --- Billing (Stripe) ---
# Paste from the Stripe dashboard. Checkout and webhooks fail closed when unset.
# One Stripe customer per workspace. Credential storage is included in the
# QueryShield prices below — do not create separate AgentVault products.
# InjectShield (the free funnel) keeps its own signup until you fold it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- Notifications ---
SENDGRID_API_KEY=
SENDGRID_FROM=alerts@queryshield.io
# Product-specific Discord webhook — separate channel from other agentic-build products.
QUERY_SHIELD_DISCORD_WEBHOOK_URL=

# --- Runtime ---
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO
MAX_ROWS_HARD_LIMIT=5000
PUBLIC_BASE_URL=https://api.queryshield.io
